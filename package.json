{
	"name": "@carrilloapps/rux",
	"version": "0.0.3",
	"description": "Windows system inspector and cleaner: startup entries, uninstall leftovers, junk files, graphics, drivers and WSL analysis, with reversible removal and a bilingual terminal interface",
	"keywords": [
		"windows",
		"startup",
		"autostart",
		"autorun",
		"cleanup",
		"junk-files",
		"leftovers",
		"uninstall",
		"registry",
		"drivers",
		"graphics",
		"gpu",
		"wsl",
		"tui",
		"ink",
		"react",
		"cli",
		"i18n"
	],
	"homepage": "https://github.com/carrilloapps/rux#readme",
	"bugs": {
		"url": "https://github.com/carrilloapps/rux/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/carrilloapps/rux.git"
	},
	"license": "MIT",
	"author": {
		"name": "Jose Carrillo",
		"email": "m@carrillo.app",
		"url": "https://github.com/carrilloapps"
	},
	"type": "module",
	"bin": {
		"rux": "dist/main.js"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"os": [
		"win32"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"start": "node dist/main.js",
		"preview": "vite-node --config vitest.config.ts scripts/preview.tsx --",
		"clean": "node scripts/clean.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"verify": "npm run format:check && npm run typecheck && npm run lint && npm run test",
		"verify:coverage": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage",
		"icons": "node scripts/build-icons.mjs",
		"package:windows": "node scripts/package-windows.mjs",
		"package:installer": "node scripts/build-installer.mjs",
		"pack:check": "npm pack --dry-run",
		"version:set": "node scripts/set-version.mjs",
		"prepublishOnly": "npm run verify && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "26.5.1",
		"@types/react": "19.3.0",
		"@vitest/coverage-v8": "5.0.0",
		"commander": "15.0.0",
		"conf": "15.1.0",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.12.0",
		"i18next": "26.4.2",
		"ink": "7.1.1",
		"ink-testing-library": "4.0.0",
		"png-to-ico": "3.0.2",
		"prettier": "3.9.6",
		"react": "19.3.0",
		"sharp": "0.35.4",
		"systeminformation": "5.33.10",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vite-node": "6.0.0",
		"vitest": "5.0.0",
		"zod": "4.6.5"
	}
}
